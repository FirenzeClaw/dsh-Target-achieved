{
  "name": "dsh-target-monitor",
  "version": "0.4.1",
  "description": "DeepSeek-Harness 收尾门：任务未声明完成时自动注入自救提醒，避免静默中断",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/FirenzeClaw/dsh-Target-achieved.git"
  },
  "homepage": "https://github.com/FirenzeClaw/dsh-Target-achieved",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "target-status",
    "turn-gate",
    "agent-harness"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "dsh.bundle.patch"
    },
    "client": {
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": "./dist/client.js"
  },
  "files": [
    "dist",
    "dsh.bundle.patch",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "scripts/build-client.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  }
}
